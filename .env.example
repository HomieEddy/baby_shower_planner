# PocketBase — required
POCKETBASE_URL=http://pocketbase:8090
VITE_POCKETBASE_URL=http://localhost:3026
# Use STRONG unique values in production (server refuses to start with the
# dev defaults when NODE_ENV=production)
PB_ADMIN_EMAIL=admin@babyshower.com
PB_ADMIN_PASSWORD=changeme123

# Gemini AI API — required
# AI thank-you drafts (OpenCode Go) — key from https://opencode.ai/auth or ~/.local/share/opencode/auth.json
THANKYOU_AI_API_KEY=
THANKYOU_AI_BASE_URL=https://opencode.ai/zen/go/v1
THANKYOU_MODEL=deepseek-v4-flash

# Resend (email delivery) — optional, falls back to console logging
RESEND_API_KEY=
EMAIL_FROM="Baby Shower <onboarding@resend.dev>"

# Twilio (SMS delivery) — optional, falls back to console logging
# Twilio Canada: use a Canadian long-code number as TWILIO_PHONE_NUMBER
# (US numbers require A2P 10DLC registration; Canadian numbers go through
# the CA 10DLC process instead). Per-message cost is ~$0.015-0.017 CA.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Admin token — guards admin API endpoints (min 16 chars; required in production)
ADMIN_TOKEN=

# App URL — required for email links; must be the Vercel frontend URL (it also
# serves as the CSRF origin allowlist entry behind the Vercel proxy)
APP_URL=http://localhost:3025

# ── Security tuning (optional, defaults are safe for Vercel + Railway) ──
# Rate limiting trusts X-Forwarded-For set by the Vercel proxy (which forwards
# the client IP to Railway). Set to false ONLY if the app port is exposed
# directly (then all clients share one IP).
TRUST_PROXY=true
# Reject known crawler/AI-scraper user agents on the API (403).
BLOCK_BOTS=true
# Max JSON body size in bytes (photo uploads arrive as base64 JSON).
MAX_BODY_BYTES=26214400
# Persist guest photo uploads here (Railway: mount a volume at /data).
UPLOAD_DIR=
